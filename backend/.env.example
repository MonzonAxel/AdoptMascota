NODE_ENV=development
PORT=3000

# Base de datos (MySQL 8)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=adoptmascota

# JWT  (generá uno propio con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))" )
JWT_SECRET=cambiar_por_un_secreto_largo
JWT_EXPIRES_IN=8h

# CORS (URL del frontend Vite)
CORS_ORIGIN=http://localhost:5173

# Imágenes
UPLOADS_DIR=uploads
MAX_FILE_SIZE_MB=5

# Usuario admin inicial (seeder)
SEED_ADMIN_EMAIL=admin@adoptmascota.com
SEED_ADMIN_PASSWORD=Admin1234!
